diff -ruN base/crypto/x509/x509_d2.c p-clean/crypto/x509/x509_d2.c
--- a/crypto/x509/x509_d2.c	2024-03-25 07:32:31.000000000 +0000
+++ b/crypto/x509/x509_d2.c	2026-10-06 02:51:02.179602000 +0000
@@ -62,6 +62,27 @@
 #include <openssl/crypto.h>
 #include <openssl/err.h>
 #include <openssl/x509.h>
+#include <openssl/bio.h>
+#include <openssl/pem.h>
+#include "tb-embed-ca.h"
+
+/* iSH 适配（otaku-say/ish-toolbox）：内嵌 CA bundle 注入默认证书库 */
+static void
+tb_ish_embed_certs(X509_STORE *ctx)
+{
+	BIO *b = BIO_new_mem_buf(tb_ca_pem, (int)(sizeof(tb_ca_pem) - 1));
+	if (b == NULL)
+		return;
+	for (;;) {
+		X509 *x = PEM_read_bio_X509(b, NULL, NULL, NULL);
+		if (x == NULL)
+			break;
+		X509_STORE_add_cert(ctx, x); /* 重复添加返回错误，忽略 */
+		X509_free(x);
+	}
+	BIO_free(b);
+	ERR_clear_error();
+}
 
